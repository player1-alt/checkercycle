import json
import os


CONFIG_FILE = "config/settings.json"


def load_settings():

    if not os.path.exists(CONFIG_FILE):

        return {
            "final_hold": 5.0
        }

    with open(
        CONFIG_FILE,
        "r",
        encoding="utf-8"
    ) as file:

        settings = json.load(file)

    # Provide a default if final_hold
    # is missing from the configuration.
    if "final_hold" not in settings:

        settings["final_hold"] = 5.0

    return settings


SETTINGS = load_settings()

