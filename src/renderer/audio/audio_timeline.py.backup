import os
import json
import shutil
import subprocess
import imageio_ffmpeg

from src.renderer.settings import SETTINGS


class AudioTimeline:
    """
    Builds the CheckerCycle audio timeline.

    Each square gets:

        square MP3 from 0:00
        for exactly 10 seconds

        followed by exactly 3 seconds of silence.

    Timing comes from config/settings.json.
    """

    def __init__(self):

        self.audio_map_file = "config/audio_map.json"

        self.audio_duration = (
            SETTINGS["audio"]["square_duration"]
        )

        self.move_pause = (
            SETTINGS["audio"]["move_pause"]
        )

        self.output_directory = (
            "CheckerCycle_audio_clips"
        )

        self.ffmpeg = (
            imageio_ffmpeg.get_ffmpeg_exe()
        )


    def build(self, events):

        print()
        print("Building audio timeline...")
        print()

        if not os.path.exists(
            self.audio_map_file
        ):

            print(
                "Audio map missing."
            )

            return []


        with open(
            self.audio_map_file,
            "r",
            encoding="utf-8"
        ) as file:

            audio_map = json.load(file)


        print(
            f"Audio duration: "
            f"{self.audio_duration}s"
        )

        print(
            f"Move pause: "
            f"{self.move_pause}s"
        )

        print(
            f"Square cycle: "
            f"{self.audio_duration + self.move_pause}s"
        )

        print()


        if os.path.exists(
            self.output_directory
        ):

            shutil.rmtree(
                self.output_directory
            )


        os.makedirs(
            self.output_directory,
            exist_ok=True
        )


        timeline = []


        for event_index, event in enumerate(events):

            print(
                f"Audio event {event_index + 1}"
            )

            print(
                "----------------"
            )


            squares = []


            if isinstance(event, dict):

                squares = event.get(
                    "path",
                    []
                )

            elif hasattr(event, "move"):

                squares = event.move.path


            if not squares:

                print(
                    "No square assigned."
                )

                self._create_silence_clip(
                    timeline
                )

                continue


            square = squares[0]

            key = str(square)


            print(
                "Square:",
                square
            )


            if key not in audio_map:

                print(
                    "No song assigned:",
                    square
                )

                self._create_silence_clip(
                    timeline
                )

                continue


            audio_file = audio_map[key]


            print(
                "Song:",
                audio_file
            )


            filepath = os.path.join(
                "assets/audio",
                audio_file
            )


            if not os.path.exists(filepath):

                print(
                    "Missing audio:",
                    filepath
                )

                self._create_silence_clip(
                    timeline
                )

                continue


            clip_number = (
                len(timeline) + 1
            )


            clip_path = os.path.join(
                self.output_directory,
                f"clip_{clip_number:04d}.mp3"
            )


            try:

                self._create_audio_clip(
                    filepath,
                    clip_path
                )


                print(
                    "Created:",
                    clip_path
                )


                timeline.append(
                    {
                        "path": [
                            clip_path
                        ],
                        "duration":
                            self.audio_duration
                            + self.move_pause
                    }
                )


            except Exception as e:

                print(
                    "FFmpeg audio error:",
                    e
                )

                self._create_silence_clip(
                    timeline
                )


        print()

        print(
            "Audio entries:",
            len(timeline)
        )


        with open(
            "CheckerCycle_audio_timeline.json",
            "w",
            encoding="utf-8"
        ) as file:

            json.dump(
                timeline,
                file,
                indent=4
            )


        print(
            "Saved CheckerCycle_audio_timeline.json"
        )


        return timeline


    def _create_audio_clip(
        self,
        source,
        output
    ):

        total_duration = (
            self.audio_duration
            + self.move_pause
        )


        # FFmpeg creates:
        #
        # 0:00 -> audio_duration
        #        source MP3 starting at 0:00
        #
        # audio_duration -> total_duration
        #        silence
        #
        # The final result is exactly one square cycle.

        filter_complex = (
            "[0:a]"
            f"atrim=start=0:"
            f"duration={self.audio_duration},"
            "asetpts=PTS-STARTPTS"
            "[music];"
            "anullsrc="
            "channel_layout=stereo:"
            "sample_rate=44100,"
            f"atrim=duration={self.move_pause},"
            "asetpts=PTS-STARTPTS"
            "[silence];"
            "[music][silence]"
            "concat=n=2:v=0:a=1"
        )


        command = [

            self.ffmpeg,

            "-y",

            "-i",
            source,

            "-filter_complex",
            filter_complex,

            "-t",
            str(total_duration),

            "-c:a",
            "libmp3lame",

            "-q:a",
            "2",

            output
        ]


        subprocess.run(
            command,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True
        )


    def _create_silence_clip(
        self,
        timeline
    ):

        total_duration = (
            self.audio_duration
            + self.move_pause
        )


        clip_number = (
            len(timeline) + 1
        )


        clip_path = os.path.join(
            self.output_directory,
            f"clip_{clip_number:04d}.mp3"
        )


        command = [

            self.ffmpeg,

            "-y",

            "-f",
            "lavfi",

            "-i",
            (
                "anullsrc="
                "channel_layout=stereo:"
                "sample_rate=44100"
            ),

            "-t",
            str(total_duration),

            "-c:a",
            "libmp3lame",

            "-q:a",
            "2",

            clip_path
        ]


        subprocess.run(
            command,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True
        )


        timeline.append(
            {
                "path": [
                    clip_path
                ],
                "duration":
                    total_duration
            }
        )


        print(
            "Created silent clip:",
            clip_path
        )
